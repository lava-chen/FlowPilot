# ---------------------------------------------------------------------------
# FlowPilot v0.1 environment
# Copy to .env.local (root) — all apps read from the repo root.
# ---------------------------------------------------------------------------

# Postgres connection string.
#
#   Option A — a real Postgres (recommended, and what Supabase gives you):
#     docker run -d --name flowpilot-db -p 5432:5432 \
#       -e POSTGRES_USER=flowpilot -e POSTGRES_PASSWORD=flowpilot \
#       -e POSTGRES_DB=flowpilot postgres:16
#     DATABASE_URL=postgresql://flowpilot:flowpilot@localhost:5432/flowpilot
#
#   Option B — zero external services (Postgres compiled to WASM, data in ./.data):
#     DATABASE_URL=pglite://./.data/flowpilot
#
# Both run the exact same migrations; Option B just stores the database in a folder.
DATABASE_URL=pglite://./.data/flowpilot

# Secret used to sign dashboard session JWTs (HS256). Use >= 32 random chars.
SESSION_SECRET=dev-only-secret-change-me-please-32-chars

# "local" issues FlowPilot-signed session tokens. "supabase" verifies Supabase Auth JWTs.
AUTH_PROVIDER=local

# Supabase (only read when AUTH_PROVIDER=supabase).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Ports
WEB_PORT=3000
MCP_PORT=3001
# Public URL of the MCP endpoint, shown in the dashboard / README.
MCP_PUBLIC_URL=http://localhost:3001/mcp

# Cookie/host settings
APP_ORIGIN=http://localhost:3000

# Set true to apply row-level-security policies (0002_rls.sql) on migrate.
# Requires a non-owner database role — leave false for local Postgres and PGlite.
FLOWPILOT_ENABLE_RLS=false

# Seed/demo behaviour: allows the "simulate inbound email" trigger in the UI.
FLOWPILOT_DEMO_MODE=true

# Optional language-model request analysis. Offline deterministic rules remain the default.
# Use an OpenAI Chat Completions-compatible endpoint; never commit the API key.
# Server-wide fallback; organization settings override this when configured.
FLOWPILOT_AI_PROVIDER=deterministic
FLOWPILOT_AI_BASE_URL=https://api.openai.com/v1
FLOWPILOT_AI_API_KEY=
FLOWPILOT_AI_MODEL=
FLOWPILOT_AI_TIMEOUT_MS=30000
